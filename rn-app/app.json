{
  "expo": {
    "name": "거시 관제탑",
    "slug": "macro-console-rn",
    "scheme": "macroconsole",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EDEEE9",
    "splash": {
      "backgroundColor": "#EDEEE9"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kr.macro.console",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "kr.macro.console",
      "adaptiveIcon": {
        "backgroundColor": "#EDEEE9"
      }
    },
    "plugins": ["expo-apple-authentication"]
  }
}
